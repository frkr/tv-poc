	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "curso",
			"database_id": "6ca78b17-7814-4158-8699-2927267cffc6"
		}
	],
	"version_metadata": {
		"binding": "CF_VERSION_METADATA"
	}
}